---
/**
 * Testimonials — 6-card quote grid with subtle hover tilt.
 *
 * v0 uses anonymised early-adopter quotes. When real testimonials
 * come in, replace the array values and add a `photo` field. The
 * card layout is tolerant of missing photos (falls back to initials).
 */

/**
 * Quotes carry bilingual body + role strings. Author name and city
 * are language-neutral so we keep them as plain strings.
 */
const quotes = [
  {
    bodyEn: "I dictate 10x more than I type now. The pill mode is genius — it's always there, never in the way.",
    bodyFr: "Je dicte 10x plus que je ne tape maintenant. Le mode pill est génial — toujours là, jamais dans le chemin.",
    author: 'A. M.',
    roleEn: 'Lead engineer, fintech',
    roleFr: 'Lead engineer, fintech',
    city: 'Paris, FR',
    tint: 'purple',
  },
  {
    bodyEn: "We use Parlys in our bilingual standups. Everyone speaks their best language, nobody sounds like Google Translate.",
    bodyFr: "On utilise Parlys dans nos standups bilingues. Chacun parle sa meilleure langue, personne ne sonne comme Google Translate.",
    author: 'S. K.',
    roleEn: 'Head of product',
    roleFr: 'Head of product',
    city: 'Berlin, DE',
    tint: 'cyan',
  },
  {
    bodyEn: "I doubled my podcast output this month. Transcribe → edit → re-voice in my own voice in Spanish for the LATAM feed.",
    bodyFr: "J'ai doublé ma prod podcast ce mois-ci. Transcription → édition → re-voix dans ma propre voix en espagnol pour le flux LATAM.",
    author: 'R. D.',
    roleEn: 'Podcaster, 200k subs',
    roleFr: 'Podcasteur, 200k abonnés',
    city: 'Barcelona, ES',
    tint: 'pink',
  },
  {
    bodyEn: "Patient notes take me 45 minutes instead of 2.5 hours. I'd pay 3x what they charge.",
    bodyFr: "Mes comptes-rendus patients prennent 45 minutes au lieu de 2h30. Je paierais 3x le prix.",
    author: 'Dr. C. L.',
    roleEn: 'GP — private practice',
    roleFr: 'Médecin généraliste — libéral',
    city: 'Lyon, FR',
    tint: 'amber',
  },
  {
    bodyEn: "The 400 ms number is not marketing fluff. I benchmarked it. It's real.",
    bodyFr: "Le chiffre des 400 ms n'est pas du marketing. J'ai benchmarké. C'est réel.",
    author: 'H. J.',
    roleEn: 'ML engineer',
    roleFr: 'Ingénieur ML',
    city: 'Tokyo, JP',
    tint: 'blue',
  },
  {
    bodyEn: "Finally a dictation app that doesn't feel like it's from 2008. The interface is beautiful.",
    bodyFr: "Enfin une app de dictée qui ne sent pas 2008. L'interface est sublime.",
    author: 'M. F.',
    roleEn: 'Freelance designer',
    roleFr: 'Designer freelance',
    city: 'New York, US',
    tint: 'purple',
  },
];
---

<section class="relative py-20 md:py-32" aria-labelledby="love-title">
  <div class="container-page px-4 md:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <div class="pill mx-auto">
        <span data-i18n-lang="en">What people say</span>
        <span data-i18n-lang="fr">Ce qu'on dit de nous</span>
      </div>
      <h2 id="love-title" class="mt-4 text-display font-semibold text-white">
        <span data-i18n-lang="en">Early adopters, already <span class="text-gradient">changed</span> for good.</span>
        <span data-i18n-lang="fr">Les premiers utilisateurs, déjà <span class="text-gradient">transformés</span> pour de bon.</span>
      </h2>
    </div>
    <div class="mx-auto mt-12 grid max-w-6xl gap-5 md:grid-cols-2 lg:grid-cols-3">
      {quotes.map((q) => (
        <figure class={`glass glass-tilt group relative overflow-hidden rounded-3xl p-6`}>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full opacity-0 transition-opacity duration-700 group-hover:opacity-60"
            style={`background: radial-gradient(circle, rgba(var(--tint), 0.35), transparent 70%); filter: blur(10px); --tint: ${
              q.tint === 'purple' ? '167, 139, 250' :
              q.tint === 'cyan'   ? '34, 211, 238'  :
              q.tint === 'pink'   ? '244, 114, 182' :
              q.tint === 'amber'  ? '251, 191, 36'  :
                                    '96, 165, 250'
            };`}
          ></div>
          <svg class="h-7 w-7 text-aurora-purple/60" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M12 8c-4 2-7 6-7 12v4h8v-8H8c0-3 2-6 6-8zm12 0c-4 2-7 6-7 12v4h8v-8h-5c0-3 2-6 6-8z"/>
          </svg>
          <blockquote class="mt-4 text-[15px] leading-relaxed text-ink-100">
            <span data-i18n-lang="en">"{q.bodyEn}"</span>
            <span data-i18n-lang="fr">« {q.bodyFr} »</span>
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-white/5 pt-4">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-aurora-purple via-aurora-pink to-aurora-cyan text-xs font-semibold text-white">
              {q.author.split(' ').map(p => p[0]).join('')}
            </span>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-white">{q.author}</div>
              <div class="text-xs text-ink-400">
                <span data-i18n-lang="en">{q.roleEn} · {q.city}</span>
                <span data-i18n-lang="fr">{q.roleFr} · {q.city}</span>
              </div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
